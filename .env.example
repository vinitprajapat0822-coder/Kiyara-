# Local placeholders only. Never commit real API keys or voice credentials.
# GitHub Actions reads actual values from repository Actions secrets.
# Required for live Gemini chat; replace only in a local ignored .env file.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# Optional custom voice output. Android system TTS remains the fallback.
ELEVENLABS_API_KEY=MY_ELEVENLABS_API_KEY
ELEVENLABS_VOICE_ID=MY_ELEVENLABS_VOICE_ID
